    "import contextlib\n",
    "import joblib\n",
    "from tqdm.auto import tqdm\n",
    "from econml.dml import CausalForestDML\n",
    "\n",
    "# Training\n",
    "## Tuning\n",
    "def optimize_lgbm(X, target, is_discrete, n_trials=15, sample_size=50000):\n",
    "    \"\"\"\n",
    "    클래스 불균형을 고려한 스마트 샘플링 기반 Optuna 튜닝 함수\n",
    "    \"\"\"\n",
    "    print(f\"[*] Optuna Tuning Started (Target Type: {'Discrete' if is_discrete else 'Continuous'})\")\n",
    "    \n",
    "    # 1. 스마트 데이터 샘플링 (불균형 데이터 보존)\n",
    "    if sample_size is not None and len(X) > sample_size:\n",
    "        # 이진 분류 문제일 경우 (주로 T 모델)\n",
    "        if is_discrete and len(np.unique(target[~np.isnan(target)])) == 2:\n",
    "            # 0과 1 중 소수 클래스 찾기\n",
    "            val_counts = pd.Series(target).value_counts()\n",
    "            minority_class = val_counts.idxmin()\n",
    "            minority_idx = np.where(target == minority_class)[0]\n",
    "            majority_idx = np.where(target != minority_class)[0]\n",
    "            \n",
    "            # 소수 클래스 데이터는 전부 가져오거나, sample_size의 절반까지만 허용\n",
    "            n_minority = min(len(minority_idx), sample_size // 2)\n",
    "            n_majority = sample_size - n_minority\n",
    "            sampled_minority = np.random.choice(minority_idx, n_minority, replace=False)\n",
    "            sampled_majority = np.random.choice(majority_idx, n_majority, replace=False)\n",
    "            \n",
    "            idx = np.concatenate([sampled_minority, sampled_majority])\n",
    "            np.random.shuffle(idx) # 학습 편향 방지를 위해 섞기\n",
    "            X_sub, target_sub = X[idx], target[idx]\n",
    "            print(f\"   -> [Smart Sample] Minority class ({minority_class}): {n_minority} / Majority class: {n_majority}\")\n",
    "            \n",
    "        # 연속형 변수이거나 다중 분류일 경우 (주로 Y 모델)\n",
    "        else:\n",
    "            idx = np.random.choice(len(X), sample_size, replace=False)\n",
    "            X_sub, target_sub = X[idx], target[idx]\n",
    "            print(f\"   -> [Random Sample] {sample_size} instances selected.\")\n",
    "    else:\n",
    "        # sample_size가 None이거나 전체 데이터가 더 적을 경우\n",
    "        X_sub, target_sub = X, target\n",
    "        print(f\"   -> [Full Data] Using all {len(X)} instances.\")\n",
    "        \n",
    "    # 2. 내부 검증셋 분할 및 Optuna 목적 함수\n",
    "    X_tr, X_va, y_tr, y_va = train_test_split(X_sub, target_sub, test_size=0.2, random_state=RANDOM_STATE)\n",
    "    \n",
    "    def objective(trial):\n",
    "        params = {\n",
    "            'n_estimators': trial.suggest_int('n_estimators', 50, 200),\n",
    "            'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.2, log=True),\n",
    "            'max_depth': trial.suggest_int('max_depth', 3, 10),\n",
    "            'num_leaves': trial.suggest_int('num_leaves', 20, 100),\n",
    "            'subsample': trial.suggest_float('subsample', 0.6, 1.0),\n",
    "            'colsample_bytree': trial.suggest_float('colsample_bytree', 0.6, 1.0),\n",
    "            'random_state': RANDOM_STATE,\n",
    "            'n_jobs': -1,\n",
    "            'verbose': -1\n",
    "        }\n",
    "        \n",
    "        # 특성에 맞게 평가 지표 설정\n",
    "        if is_discrete:\n",
    "            # 불균형 데이터 분류 최적화를 위해 class_weight 적용\n",
    "            model = LGBMClassifier(**params, class_weight='balanced')\n",
    "            model.fit(X_tr, y_tr)\n",
    "            preds = model.predict_proba(X_va)[:, 1] if len(np.unique(y_tr)) == 2 else model.predict(X_va)\n",
    "            try:\n",
    "                score = log_loss(y_va, preds)\n",
    "            except:\n",
    "                score = mean_squared_error(y_va, preds) # Fallback\n",
    "        else:\n",
    "            model = LGBMRegressor(**params)\n",
    "            model.fit(X_tr, y_tr)\n",
    "            preds = model.predict(X_va)\n",
    "            score = mean_squared_error(y_va, preds)\n",
    "            \n",
    "        return score\n",
    "\n",
    "    # 경고창 끄기 및 최적화 실행\n",
    "    optuna.logging.set_verbosity(optuna.logging.WARNING)\n",
    "    study = optuna.create_study(direction='minimize')\n",
    "    study.optimize(objective, n_trials=n_trials, show_progress_bar=True)\n",
    "    \n",
    "    print(f\"   -> Best Score: {study.best_value:.4f}\")\n",
    "    return study.best_params\n",
    "\n",
    "## Setting\n",
    "Y_discrete = False\n",
