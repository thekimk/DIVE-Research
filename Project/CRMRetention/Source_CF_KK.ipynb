    "n_0_sample = min(len(idx_1) * 5, len(idx_0)) \n",
    "np.random.seed(RANDOM_STATE)\n",
    "sampled_idx_0 = np.random.choice(idx_0, size=n_0_sample, replace=False)\n",
    "final_train_idx = np.concatenate([idx_1, sampled_idx_0])\n",
    "np.random.shuffle(final_train_idx)\n",
    "\n",
    "Y_train_cf = df_prep['Y_train'][final_train_idx]\n",
    "T_train_cf = df_prep['T_train'][final_train_idx]\n",
